# Supabase 대시보드 → Connect → Session pooler 연결 문자열 (postgresql:// 그대로 붙여 넣어도 됨)
DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → JWT Keys. Legacy JWT secret을 쓰는 프로젝트만 필요 (새 Signing Keys면 비워 둠)
SUPABASE_JWT_SECRET=

KAKAO_REST_API_KEY=
# 사진 판정 (F.2) — Google AI Studio → Get API key
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite

# 쉼표로 구분
CORS_ORIGINS=http://localhost:5173
