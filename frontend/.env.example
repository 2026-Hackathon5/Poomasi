# 이 파일을 복사해서 .env를 만들고 값을 채워 주세요 (.env는 깃에 올라가지 않아요)

# 카카오맵 JavaScript 키
VITE_KAKAO_MAP_KEY=

# 백엔드 서버 주소 (비우면 https://poomasi.onrender.com)
VITE_API_BASE_URL=https://poomasi.onrender.com

# Supabase 대시보드 → Project Settings → API Keys
# publishable 키(sb_publishable_...)만 넣기. sb_secret_ 키는 절대 넣지 말 것
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
